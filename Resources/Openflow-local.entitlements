<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone access under the hardened runtime. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Local (self-signed) builds only: a certificate without an Apple Team ID cannot pass library
         validation, which would block the app's own embedded Sparkle.framework. Developer ID builds use
         Openflow.entitlements, which keeps library validation on. DYLD environment injection stays blocked. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
